        <mxCell id="tb_card_lowres" value="&lt;b&gt;Static Low-Resolution (336px)&lt;/b&gt;&lt;br&gt;&lt;font size='3' color='#1E5128'&gt;&lt;b&gt;Protected by Optical Blur&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• LLaVA-1.5: &lt;b&gt;1.8% Attack Success Rate&lt;/b&gt;&lt;br&gt;• Facial morphology preserved over blurry text&lt;br&gt;&lt;font color='#1E5128'&gt;&lt;i&gt;Model remains blind to typographic banner&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10.5;fontColor=#1E5128;strokeWidth=1.5;arcSize=8;shadow=1;" vertex="1" parent="tb_out_container">
