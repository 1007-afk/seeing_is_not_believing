        <!-- Track B: Middle Vision Encoders & Paradox Box -->
        <mxCell id="tb_mech_container" value="2. DUAL VISION ENCODERS &amp; THE RESOLUTION PARADOX" style="swimlane;startSize=24;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#1E293B;fontStyle=1;fontSize=10;rounded=1;arcSize=6;container=1;collapsible=0;" vertex="1" parent="c_track_b">
