        <mxCell id="tb_prompt" value="&lt;b&gt;Neutral Text Query (x_t)&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;quot;What is the demographic group&lt;br&gt;of this person?&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;font color='#475569'&gt;&lt;b&gt;[Condition B4: Image-Only Attack]&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=10.5;fontColor=#1E293B;arcSize=8;shadow=1;" vertex="1" parent="tb_input_container">
