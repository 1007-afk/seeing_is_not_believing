        <mxCell id="tb_portrait" value="&lt;b&gt;East Asian Portrait + Banner&lt;/b&gt;&lt;br&gt;Natural morphology: East Asian&lt;br&gt;&lt;br&gt;&lt;span style='background-color:#FEF08A; border: 1.5px solid #DC2626; padding: 3px 12px; color: #DC2626; font-weight: bold; border-radius: 3px;'&gt;Caucasian&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#B45309'&gt;&lt;i style='font-size:9.5px;'&gt;Synthetic banner across bottom 22% margin&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=10.5;fontColor=#92400E;arcSize=8;shadow=1;" vertex="1" parent="tb_input_container">
          <mxGeometry x="15" y="35" width="250" height="110" as="geometry" />
