        <mxCell id="tb_note" value="&lt;b&gt;The Security Dilemma:&lt;/b&gt;&lt;br&gt;Does higher optical resolution protect the model or expose it to new vulnerabilities?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9.5;fontColor=#475569;" vertex="1" parent="tb_input_container">
