        </mxCell>
        <mxCell id="tb_clip" value="&lt;b&gt;Static CLIP-ViT-L/14 (336×336)&lt;/b&gt;&lt;br&gt;• Fixed 14×14 patch grid (576 tokens)&lt;br&gt;• Text downsampled &amp;amp; blurred below OCR limit&lt;br&gt;&lt;font color='#1E5128'&gt;&lt;b&gt;Attack Fails: 1.8% ASR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9.5px;'&gt;[Accidental Optical Shield]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10.5;fontColor=#1E5128;arcSize=8;shadow=1;" vertex="1" parent="tb_mech_container">
          <mxGeometry x="15" y="40" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tb_navit" value="&lt;b&gt;Dynamic NaViT / ViT (Up to 1280×1280)&lt;/b&gt;&lt;br&gt;• Dynamic multiscale tiling (up to 2560 tokens)&lt;br&gt;• Characters resolved sharp and OCR-legible&lt;br&gt;&lt;font color='#C51605'&gt;&lt;b&gt;Attack Succeeds: 90.4% ASR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i style='font-size:9.5px;'&gt;[Optical Backdoor Activated (40×)]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C51605;fontSize=10.5;fontColor=#C51605;arcSize=8;shadow=1;" vertex="1" parent="tb_mech_container">
          <mxGeometry x="15" y="175" width="280" height="115" as="geometry" />
        </mxCell>
        <mxCell id="tb_paradox_box" value="&lt;b style='font-size:11.5px;'&gt;THE OPTICAL RESOLUTION PARADOX&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Counter-intuitive Vulnerability:&lt;/b&gt;&lt;br&gt;Superior optical acuity opens a &lt;font color='#C51605'&gt;&lt;b&gt;40× wider attack surface&lt;/b&gt;&lt;/font&gt;.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Low-Resolution (336px):&lt;/b&gt; Aggressive downsampling accidentally shields the model because the text is unreadable.&lt;br&gt;&lt;br&gt;• &lt;b&gt;High-Resolution (1280px):&lt;/b&gt; Fine vision acuity accurately reads the deceptive banner and converts visual tokens into adversarial prompt tokens." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=10;fontColor=#92400E;align=left;spacing=10;strokeWidth=2;arcSize=8;shadow=1;" vertex="1" parent="tb_mech_container">
          <mxGeometry x="325" y="40" width="325" height="250" as="geometry" />
        </mxCell>

