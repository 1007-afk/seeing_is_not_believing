        <mxCell id="e7" value="Residual Stream" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7B1FA2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="dec_early" target="dec_l1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="Suppressed Logits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C51605;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="dec_l1" target="dec_final">
          <mxGeometry relative="1" as="geometry" />
